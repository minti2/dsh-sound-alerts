{
  "name": "@minti2/dsh-sound-alerts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Play a chime when a turn finishes, when the harness needs your attention, or when a turn fails.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "sounds/*.wav",
    "scripts"
  ],
  "scripts": {
    "generate-sounds": "node scripts/generate-sounds.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
