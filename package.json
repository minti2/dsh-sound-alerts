{
  "name": "@minti2/dsh-sound-alerts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Play a chime in the browser when a turn finishes, when the harness needs your attention, or when a turn fails.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
